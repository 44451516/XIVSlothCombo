<Project>

  <!--
    Settings that reach the libraries in the submodules.

    The file lives in the root of the repository on purpose: the submodules
    themselves are left untouched, but the libraries in them are built as part
    of this repository, so their warnings are dealt with here.

    Only the projects that are named below are touched. Everything else, the
    legacy plugin included, is built exactly as it was.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FFXIVClientStructs'">
    <!--
      The generated code of the struct library carries documentation that the
      compiler does not accept, and the library itself is written with names
      the compiler would rather not see. None of it is a problem of this
      repository, so the warnings are put to silence.
    -->
    <NoWarn>$(NoWarn);CS1584;CS1658;CS1573;CS1572;CS1574;CS8981;IDE0251</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'InteropGenerator'">
    <!-- The release notes of the analyzer are not formatted the way the
         analyzer of the compiler expects them to be. -->
    <NoWarn>$(NoWarn);RS2007</NoWarn>
  </PropertyGroup>

</Project>
