<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SlothCombo.Loader</RootNamespace>
    <AssemblyName>SlothCombo.Loader</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The loader sits in the default load context of the game for the rest of
    the session, so it must not pull anything in that the runtime is meant to
    own. It talks to the runtime through reflection alone.
  -->

</Project>
