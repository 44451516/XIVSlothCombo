<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SlothCombo.Boot</AssemblyName>
    <RootNamespace>SlothCombo.Boot</RootNamespace>

    <!--
      The boot library is the piece that is injected into the game. It is
      built ahead of time so that it does not need a runtime of its own: it
      only needs to find the runtime of the host program and hand it over.
    -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <UseAppHost>false</UseAppHost>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <!--
    The library is loaded into the game by the injector, which cannot pass any
    arguments. The export of the library is exactly the hook that is needed for
    that, so the advice of the analyzer about the entry points of a library
    does not apply here.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

</Project>
