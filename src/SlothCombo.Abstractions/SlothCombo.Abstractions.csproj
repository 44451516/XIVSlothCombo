<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SlothCombo.Abstractions</RootNamespace>
    <AssemblyName>SlothCombo.Abstractions</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!--
    This project is the seam between the game logic and whatever hosts it.

    It has no dependency on Dalamud: the game logic only ever talks to the
    interfaces declared here, so the same source files can be hosted by the
    standalone runtime (which implements them on top of its own interop layer)
    and by the legacy Dalamud plugin (which implements them on top of the
    Dalamud services).

    The static data of the game is declared here as well, as plain rows and
    as the table that holds them. The rows are the contract between the
    program and the tables that are carried along with it, so they belong
    here rather than in the layer that reads them.
  -->

</Project>
