<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SlothCombo.Runtime</RootNamespace>
    <AssemblyName>SlothCombo.Runtime</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591;CS8618;CS8600;CS8603;CS8625;CS8602</NoWarn>

    <!--
      The runtime is loaded into the game by the boot library, which hands it
      to the host of the runtime as a plain assembly. The host reads the
      configuration of the runtime from the file that sits next to the
      assembly, so the file has to be produced even though this project is a
      library.
    -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlothCombo.Abstractions\SlothCombo.Abstractions.csproj" />
  </ItemGroup>

  <!--
    The layer that talks to the game and the layer that reads the tables of the
    game are both written for this program, so they are plain project
    references. Neither of them references Dalamud, so the runtime stays
    independent of the plugin host.

    The reference is a plain one on purpose. A reference that carries
    properties of its own makes the build graph build the library twice, and
    two compilers then write the same file at the same time.

    The assemblies of these libraries are copied next to the runtime, because
    the runtime is loaded into the game on its own and cannot reach the build
    output of another project there.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SlothCombo.Interop\SlothCombo.Interop.csproj" />
    <ProjectReference Include="..\SlothCombo.GameData\SlothCombo.GameData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reloaded.Hooks" Version="4.3.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
