<Project>

  <!--
    Shared build settings for the standalone program.

    These properties sit next to the projects of the program on purpose. A
    file in the root of the repository would also reach every project of the
    repository, whatever it is, and it would change how they are built. The
    standalone program is built on its own, so it carries its own settings and
    leaves the rest of the repository alone.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!--
      The struct library is a set of 1:1 memory layouts, so every project that
      talks to it needs unsafe blocks. The flag is declared unconditionally
      because it is required by the runtime and harmless for the others.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      The program only ever ships for 64 bit Windows. The runtime identifier
      is given when the installation is published, because the runtime that is
      carried along has to match the one the game is started with.

      Every project of the program is built for 64 bit as well. A program that
      reaches into the game has to have the same width as the game, and a
      build that mixes the two makes the build graph build a library twice,
      which ends in two compilers writing the same file.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
