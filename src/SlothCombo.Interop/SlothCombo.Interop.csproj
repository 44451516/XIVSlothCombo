<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The layer that talks to the game.

    The offsets of the structures of the game and the addresses of its
    functions are written down here by hand, so the program does not carry a
    library of a thousand structures it only uses a fraction of.

    The project sits next to the other projects of the program on purpose: a
    file of settings in the root of the repository would also reach the
    libraries in the submodules and change how they are built.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!--
      The structures of the game are a set of 1:1 memory layouts, so every
      project that talks to it needs unsafe blocks.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SlothCombo.Interop</AssemblyName>
    <RootNamespace>SlothCombo.Interop</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

<ItemGroup>
    <!--
      The contract of the scanner lives in the layer that holds the contracts
      of the program, so the layer that talks to the game does not have to
      carry a copy of it.
    -->
    <ProjectReference Include="..\SlothCombo.Abstractions\SlothCombo.Abstractions.csproj" />
  </ItemGroup>

</Project>
